# Configuración de ComicDB
# Copia este archivo a .env y completa con tus valores
# NUNCA commitees el archivo .env con valores reales

# API Key de Comic Vine
COMIC_VINE_API_KEY=tu_api_key_aqui

# Configuración del servidor
NODE_ENV=development
SERVER_PORT=8000

# Configuración de la aplicación
APP_NAME=ComicDB
APP_VERSION=1.0.0
RESULTS_PER_PAGE=10

# Mapa (coordenadas de Catedral de La Plata)
MAP_LAT=-34.9215
MAP_LNG=-57.9536
MAP_ZOOM=15
